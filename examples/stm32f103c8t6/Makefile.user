##############################################################################
# Makefile.user — esp-net-framework 自加的编译内容
#
# 这个文件是「我们管的部分」。CubeMX 不认识也不生成它，所以**用 CubeMX 重新
# 生成代码时不会被覆盖**。
#
# 唯一需要在重新生成后补回的是主 Makefile 里的这一行（CubeMX 会覆盖主 Makefile）：
#     -include Makefile.user
# 位置：紧跟在 C_INCLUDES 定义之后。
#
# 新增自己的源文件时，往下加一行即可。
##############################################################################

# 框架本体 + 移植层 + demo 业务
#   ../../library  = 平台无关的联网框架（esp_net / esp8266_at / mqtt_client）
#   ../../port     = STM32F1 移植层（USART2 DMA 循环 + IDLE 中断 + PA8 复位）
C_SOURCES += \
../../library/esp8266_at.c \
../../library/mqtt_client.c \
../../library/esp_net.c \
../../port/esp_port_stm32f1.c \
Core/Src/demo_app.c

C_INCLUDES += \
-I../../library \
-I../../port

##############################################################################
# 头文件依赖（别删）
#
# 主 Makefile 的编译规则只让 .o 依赖 .c，**不依赖 .h**。也就是说你改
# ../../library/esp_net_config.h（最常改的 WiFi / 服务器配置）之后 make 会说
# "Nothing to be done"，根本不会重编 —— 于是你烧进去的还是旧固件，却以为
# 改动没生效。这类静默错误最难查，所以必须显式打开头文件依赖。
#
# 做法：-MMD -MP 让编译器顺手生成 <目标名>.d（记录该 .o 依赖了哪些头文件），
#       再把 .d 读回来当作依赖规则。
#
# 为什么写在本文件而不是主 Makefile：主 Makefile 会被 CubeMX 重新生成时覆盖，
# 本文件不会，所以这个修复能长期存活。
##############################################################################

# 目标专属变量：只给 .o 的编译加 -MMD -MP，不影响汇编
%.o: CFLAGS += -MMD -MP

# ★ 必须显式指定默认目标。
#   原因：make 的默认目标是「Makefile 里第一个出现的 target」，而本文件是在
#   主 Makefile 的 `all:` 之前被 include 的，下面 include 进来的每个 .d 文件
#   里第一条规则都会抢走默认目标（表现为 mingw32-make 只去构建某一个 .o，
#   打印 "... is up to date"），`all` 就再也不会被执行 —— 比不重编还糟。
.DEFAULT_GOAL := all

-include $(wildcard $(BUILD_DIR)/*.d)